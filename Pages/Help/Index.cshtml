@page "/Help/{chapterSlug?}"
@model NLI_POS.Pages.Help.IndexModel
@{
    ViewData["Title"] = Model.SelectedChapter?.Title ?? "Help";
}

<link rel="stylesheet" href="~/css/help.css" asp-append-version="true" />

<div class="help-page container-fluid py-3 px-3 px-lg-4">
    <header class="help-header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h3 text-primary mb-1">Help</h1>
            <p class="text-muted mb-0">Browse the guide or search for a topic.</p>
        </div>
        <button type="button" class="btn btn-outline-secondary help-print" onclick="window.print()">
            <i class="fas fa-print me-1" aria-hidden="true"></i> Print
        </button>
    </header>

    <div class="help-shell">
        <aside class="help-sidebar card" aria-label="Help navigation">
            <form method="get" action="/Help" class="p-3 border-bottom">
                <label for="helpSearch" class="form-label fw-semibold">Search chapters</label>
                <div class="input-group">
                    <input id="helpSearch" name="q" value="@Model.SearchQuery" class="form-control"
                           type="search" placeholder="Search the guide" />
                    <button class="btn btn-primary" type="submit" aria-label="Search help">
                        <i class="fas fa-search" aria-hidden="true"></i>
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <a class="small d-inline-block mt-2" href="/Help">Clear search</a>
                }
            </form>

            <nav class="help-chapters" aria-label="Help chapters">
                @if (Model.Chapters.Count == 0)
                {
                    <p class="p-3 mb-0 text-muted">No chapters match your search.</p>
                }
                else
                {
                    <ol class="list-unstyled mb-0">
                        @foreach (var chapter in Model.Chapters)
                        {
                            var isActive = Model.SelectedChapter?.Slug == chapter.Slug;
                            <li>
                                <a class="help-chapter-link @(isActive ? "active" : string.Empty)"
                                   href="/Help/@chapter.Slug" aria-current="@(isActive ? "page" : null)">
                                    <span class="help-chapter-order">@chapter.Order.</span>
                                    @chapter.Title
                                </a>
                            </li>
                        }
                    </ol>
                }
            </nav>
        </aside>

        <main class="help-main card">
            @if (Model.ChapterNotFound)
            {
                <section class="help-empty p-4" role="status">
                    <h2 class="h4">Page not found</h2>
                    <p class="mb-0">That Help chapter is not available. Choose a chapter from the list or clear your search.</p>
                </section>
            }
            else if (Model.SelectedChapter is null)
            {
                <section class="help-empty p-4" role="status">
                    <h2 class="h4">No matching chapters</h2>
                    <p class="mb-0">Try a different search term or clear the search to browse all available chapters.</p>
                </section>
            }
            else
            {
                <article class="help-article">
                    <div class="help-article-grid @(Model.SelectedChapter.Headings.Count == 0 ? "no-mini-toc" : string.Empty)">
                        @if (Model.SelectedChapter.Headings.Count > 0)
                        {
                            <nav class="help-on-this-page" aria-label="On this page">
                                <h2 class="h6 fw-bold">On this page</h2>
                                <ol class="list-unstyled mb-0">
                                    @foreach (var heading in Model.SelectedChapter.Headings)
                                    {
                                        <li><a href="#@heading.Id">@heading.Title</a></li>
                                    }
                                </ol>
                            </nav>
                        }

                        <div class="help-content">
                            @Html.Raw(Model.SelectedChapter.RenderedContent)
                        </div>
                    </div>

                    <nav class="help-chapter-nav d-flex justify-content-between gap-3 border-top p-3" aria-label="Chapter navigation">
                        <div>
                            @if (Model.PreviousChapter is not null)
                            {
                                <a href="/Help/@Model.PreviousChapter.Slug@(string.IsNullOrWhiteSpace(Model.SearchQuery) ? string.Empty : $"?q={Uri.EscapeDataString(Model.SearchQuery)}")">
                                    <i class="fas fa-arrow-left me-1" aria-hidden="true"></i> Previous: @Model.PreviousChapter.Title
                                </a>
                            }
                        </div>
                        <div class="text-end">
                            @if (Model.NextChapter is not null)
                            {
                                <a href="/Help/@Model.NextChapter.Slug@(string.IsNullOrWhiteSpace(Model.SearchQuery) ? string.Empty : $"?q={Uri.EscapeDataString(Model.SearchQuery)}")">
                                    Next: @Model.NextChapter.Title <i class="fas fa-arrow-right ms-1" aria-hidden="true"></i>
                                </a>
                            }
                        </div>
                    </nav>
                </article>
            }
        </main>
    </div>
</div>

<div id="helpImageViewer" class="help-image-viewer" role="dialog" aria-modal="true" aria-label="Expanded screenshot" hidden>
    <button type="button" class="help-image-close" aria-label="Close expanded screenshot">&times;</button>
    <img alt="" />
</div>

@section Scripts {
    <script>
        (() => {
            const viewer = document.getElementById("helpImageViewer");
            const expandedImage = viewer.querySelector("img");
            const closeButton = viewer.querySelector(".help-image-close");

            document.querySelectorAll(".help-content img").forEach(image => {
                image.addEventListener("click", () => {
                    expandedImage.src = image.src;
                    expandedImage.alt = image.alt;
                    viewer.hidden = false;
                    closeButton.focus();
                });
            });

            const closeViewer = () => {
                viewer.hidden = true;
                expandedImage.removeAttribute("src");
            };

            closeButton.addEventListener("click", closeViewer);
            viewer.addEventListener("click", event => {
                if (event.target === viewer) closeViewer();
            });
            document.addEventListener("keydown", event => {
                if (event.key === "Escape" && !viewer.hidden) closeViewer();
            });
        })();
    </script>
}
